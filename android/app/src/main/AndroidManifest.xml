<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Recording a track with the screen off: a foreground service of the location type, with its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Updates: Mahere installs its own new builds (after Photon's), without asking once it is its own installer of record. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <application
        android:label="Mahere"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:extractNativeLibs="true">
        <!-- Profileable from the shell (Android's heap and CPU profilers over adb), as Google recommends for release builds: no debugging, no data access (2026-10-23: finding where a Pixel 3a's memory went). -->
        <profileable android:shell="true" />
        <activity
            android:name=".MahereActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode|fontScale"
            android:screenOrientation="portrait"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A shared place: geo:lat,lon or geo:0,0?q=lat,lon, with ?z= a web zoom level. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
            <!-- A shared area document (.vsf.zst), sent to the app or opened with it; messaging apps type it as they please, so the plain types are taken too and anything that is not an area is ignored. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.mahere.area" />
                <data android:mimeType="application/zstd" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!-- Recording a track, the screen on or off. -->
        <service
            android:name=".MahereTrackService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- The package installer's answer to an update: the first time, the system's confirm. -->
        <receiver
            android:name=".MahereInstallReceiver"
            android:exported="false" />
        <!-- After an update: the map opened again (MY_PACKAGE_REPLACED is sent by the system alone, so exporting it is safe). -->
        <receiver
            android:name=".MahereUpdatedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- The app's own files for the share sheet (an area document under files/share). -->
        <provider
            android:name=".ShareProvider"
            android:authorities="nz.mahere.app.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
